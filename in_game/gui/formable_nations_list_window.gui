				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'O')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'O')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_P"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'P')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'P')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_R"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'R')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'R')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_S"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'S')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'S')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_T"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'T')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'T')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_U"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'U')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'U')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_V"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'V')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'V')]"
