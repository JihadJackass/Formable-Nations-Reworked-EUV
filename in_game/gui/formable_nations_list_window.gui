				text = "fnr_toggle_letter_H"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'H')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'H')]"
			}
