# Formable Nations: Reworked - Individual Formables window
# Generated 2026-11-02 from fnr_formable_countries.txt and 00_formable_countries.txt: every formable with its own toggle, grouped by
# rank and sorted by name. Each row shows the formable, its category and its current state.
# Clicking a row cycles Default -> Forced Off -> Forced On -> Default (FormableNationReworked_toggle_*).
# Default follows the category toggle in the settings window.

window = {
	name = "formable_nations_list_window"
	layer = windows_layer
	parentanchor = center
	size = { 1000 800 }
	visible = "[GetVariableSystem.Exists('formable_list_window_open')]"
	using = bg_window_default_alt

	widget = {
		parentanchor = top|right
		position = { -15 15 }
		size = { 40 40 }

		button_close_alt = {
			# 1.4.6: vanilla closes this button through "close_on_action". Its own Esc binding is
			# removed so only the overlay button below owns Esc.
			blockoverride "close_on_action" { on_action = "[GetVariableSystem.Clear('formable_list_window_open')]" }
			blockoverride "close_inputaction" {}
		}

		button = {
			size = { 40 40 }
			input_action = "close_window"
			tooltip = "fnr_settings_close_tooltip"
			onclick = "[GetVariableSystem.Clear('formable_list_window_open')]"
		}
	}

	vbox = {
		margin = { 25 20 }
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		spacing = 8

		text_single = {
			text = "fnr_toggle_window_title"
		}
		text_multi = {
			layoutpolicy_horizontal = expanding
			autoresize = yes
			max_width = 940
			text = "fnr_toggle_window_help"
		}
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 10
			button_regular = {
				size = { 260 32 }
				text = "fnr_toggle_reset_all"
				tooltip = "fnr_toggle_reset_all_tt"
				onclick = "[GetScriptedGui('FormableNationReworked_reset_individual_toggles').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			button_regular = {
				size = { 200 32 }
				text = "fnr_toggle_back_to_settings"
				tooltip = "fnr_toggle_back_to_settings_tt"
				onclick = "[GetVariableSystem.Clear('formable_list_window_open')]"
			}
			button_regular = {
				size = { 160 32 }
				text = "fnr_toggle_clear_filters"
				tooltip = "fnr_toggle_clear_filters_tt"
				onclick = "[GetVariableSystem.Clear('fnr_filter_letter')]"
				onclick = "[GetVariableSystem.Clear('fnr_filter_cat')]"
			}
			expand = {}
		}
		# Enabled formables (FormableNationReworked_count_active)
		text_single = {
			text = "fnr_toggle_count"
		}
		# Filter by first letter
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3
			expand = {}
			button_regular = {
				size = { 46 28 }
				text = "fnr_toggle_filter_all"
				tooltip = "fnr_toggle_filter_letter_all_tt"
				onclick = "[GetVariableSystem.Clear('fnr_filter_letter')]"
				down = "[Not(GetVariableSystem.Exists('fnr_filter_letter'))]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_A"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'A')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'A')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_B"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'B')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'B')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_C"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'C')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'C')]"
			}
			button_regular = {
