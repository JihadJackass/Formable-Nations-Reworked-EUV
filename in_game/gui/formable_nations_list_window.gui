				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'D')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'D')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_E"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'E')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'E')]"
			}
			button_regular = {
