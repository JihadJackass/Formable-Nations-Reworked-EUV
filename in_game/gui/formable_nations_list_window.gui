				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'K')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_L"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'L')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'L')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_M"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'M')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'M')]"
			}
			button_regular = {
