		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			size = { 0 0 }

			blockoverride "scrollbox_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 5
					margin = { 10 10 }
					margin_right = 30

					# Rank I Formables
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 3
						visible = "[And(Or(Not(GetVariableSystem.Exists('fnr_filter_letter')), Or(Or(GetVariableSystem.HasValue('fnr_filter_letter', 'C'), GetVariableSystem.HasValue('fnr_filter_letter', 'D')), Or(GetVariableSystem.HasValue('fnr_filter_letter', 'H'), GetVariableSystem.HasValue('fnr_filter_letter', 'P')))), Or(Not(GetVariableSystem.Exists('fnr_filter_cat')), Or(Or(GetVariableSystem.HasValue('fnr_filter_cat', 'historical'), GetVariableSystem.HasValue('fnr_filter_cat', 'modern')), GetVariableSystem.HasValue('fnr_filter_cat', 'nonhistorical'))))]"

						button_main_tab_alt = {
							using = layoutpolicy_expanding
							raw_text = "Rank I Formables (5)"
							tooltip = "fnr_toggle_rank_tt"
							onclick = "[GetVariableSystem.Toggle('rank1_open')]"
							down = "[Or(GetVariableSystem.Exists('rank1_open'), Or(GetVariableSystem.Exists('fnr_filter_letter'), GetVariableSystem.Exists('fnr_filter_cat')))]"
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							visible = "[Or(GetVariableSystem.Exists('rank1_open'), Or(GetVariableSystem.Exists('fnr_filter_letter'), GetVariableSystem.Exists('fnr_filter_cat')))]"
							spacing = 2
							margin = { 10 5 }

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 2

								# County of Edessa (COEDS_f)
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 10
									visible = "[And(Or(Not(GetVariableSystem.Exists('fnr_filter_letter')), GetVariableSystem.HasValue('fnr_filter_letter', 'C')), Or(Not(GetVariableSystem.Exists('fnr_filter_cat')), GetVariableSystem.HasValue('fnr_filter_cat', 'nonhistorical')))]"
									button_regular = {
										size = { 330 30 }
										raw_text = "County of Edessa"
										tooltip = "fnr_toggle_row_tt"
										onclick = "[GetScriptedGui('FormableNationReworked_toggle_county_of_edessa').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									text_single = {
										size = { 130 30 }
										autoresize = no
										align = left|nobaseline
										raw_text = "Non-Historical"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[GetPlayer.HasVariable('fnr_county_of_edessa_enabled')]"
										text = "fnr_toggle_state_on"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[GetPlayer.HasVariable('fnr_county_of_edessa_disabled')]"
										text = "fnr_toggle_state_off"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[And(Not(GetPlayer.HasVariable('fnr_county_of_edessa_enabled')), And(Not(GetPlayer.HasVariable('fnr_county_of_edessa_disabled')), GetPlayer.HasVariable('fnr_nonhistorical_enabled')))]"
										text = "fnr_toggle_state_default_on"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[And(Not(GetPlayer.HasVariable('fnr_county_of_edessa_enabled')), And(Not(GetPlayer.HasVariable('fnr_county_of_edessa_disabled')), Not(GetPlayer.HasVariable('fnr_nonhistorical_enabled'))))]"
										text = "fnr_toggle_state_default_off"
									}
									expand = {}
								}
								# County of Tripoli (COTRP_f)
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 10
									visible = "[And(Or(Not(GetVariableSystem.Exists('fnr_filter_letter')), GetVariableSystem.HasValue('fnr_filter_letter', 'C')), Or(Not(GetVariableSystem.Exists('fnr_filter_cat')), GetVariableSystem.HasValue('fnr_filter_cat', 'nonhistorical')))]"
									button_regular = {
										size = { 330 30 }
										raw_text = "County of Tripoli"
										tooltip = "fnr_toggle_row_tt"
										onclick = "[GetScriptedGui('FormableNationReworked_toggle_county_of_tripoli').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									text_single = {
										size = { 130 30 }
										autoresize = no
										align = left|nobaseline
										raw_text = "Non-Historical"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[GetPlayer.HasVariable('fnr_county_of_tripoli_enabled')]"
										text = "fnr_toggle_state_on"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[GetPlayer.HasVariable('fnr_county_of_tripoli_disabled')]"
										text = "fnr_toggle_state_off"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[And(Not(GetPlayer.HasVariable('fnr_county_of_tripoli_enabled')), And(Not(GetPlayer.HasVariable('fnr_county_of_tripoli_disabled')), GetPlayer.HasVariable('fnr_nonhistorical_enabled')))]"
										text = "fnr_toggle_state_default_on"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[And(Not(GetPlayer.HasVariable('fnr_county_of_tripoli_enabled')), And(Not(GetPlayer.HasVariable('fnr_county_of_tripoli_disabled')), Not(GetPlayer.HasVariable('fnr_nonhistorical_enabled'))))]"
										text = "fnr_toggle_state_default_off"
									}
									expand = {}
								}
								# Ducal Prussia (DCLPR_f)
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 10
									visible = "[And(Or(Not(GetVariableSystem.Exists('fnr_filter_letter')), GetVariableSystem.HasValue('fnr_filter_letter', 'D')), Or(Not(GetVariableSystem.Exists('fnr_filter_cat')), GetVariableSystem.HasValue('fnr_filter_cat', 'historical')))]"
									button_regular = {
										size = { 330 30 }
										raw_text = "Ducal Prussia"
										tooltip = "fnr_toggle_row_tt"
										onclick = "[GetScriptedGui('FormableNationReworked_toggle_ducalprussia').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									text_single = {
										size = { 130 30 }
										autoresize = no
										align = left|nobaseline
										raw_text = "Historical"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[GetPlayer.HasVariable('fnr_ducalprussia_enabled')]"
										text = "fnr_toggle_state_on"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[GetPlayer.HasVariable('fnr_ducalprussia_disabled')]"
										text = "fnr_toggle_state_off"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[And(Not(GetPlayer.HasVariable('fnr_ducalprussia_enabled')), And(Not(GetPlayer.HasVariable('fnr_ducalprussia_disabled')), GetPlayer.HasVariable('fnr_historical_enabled')))]"
										text = "fnr_toggle_state_default_on"
									}
									text_single = {
										size = { 160 30 }
										autoresize = no
										align = left|nobaseline
										visible = "[And(Not(GetPlayer.HasVariable('fnr_ducalprussia_enabled')), And(Not(GetPlayer.HasVariable('fnr_ducalprussia_disabled')), Not(GetPlayer.HasVariable('fnr_historical_enabled'))))]"
										text = "fnr_toggle_state_default_off"
									}
									expand = {}
								}
								# Pamiristan (PMSTN_f)
								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 10
									visible = "[And(Or(Not(GetVariableSystem.Exists('fnr_filter_letter')), GetVariableSystem.HasValue('fnr_filter_letter', 'P')), Or(Not(GetVariableSystem.Exists('fnr_filter_cat')), GetVariableSystem.HasValue('fnr_filter_cat', 'modern')))]"
									button_regular = {
										size = { 330 30 }
										raw_text = "Pamiristan"
										tooltip = "fnr_toggle_row_tt"
										onclick = "[GetScriptedGui('FormableNationReworked_toggle_pamiristan').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									text_single = {
										size = { 130 30 }
										autoresize = no
										align = left|nobaseline
										raw_text = "Modern"
									}
