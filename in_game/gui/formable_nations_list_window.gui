				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'W')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'W')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_Y"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'Y')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'Y')]"
			}
			button_regular = {
				size = { 32 28 }
				text = "fnr_toggle_letter_Z"
				tooltip = "fnr_toggle_filter_letter_tt"
				onclick = "[GetVariableSystem.Set('fnr_filter_letter', 'Z')]"
				down = "[GetVariableSystem.HasValue('fnr_filter_letter', 'Z')]"
			}
			expand = {}
		}
		# Filter by category
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 3
			expand = {}
			button_regular = {
				size = { 46 28 }
				text = "fnr_toggle_filter_all"
				tooltip = "fnr_toggle_filter_cat_all_tt"
				onclick = "[GetVariableSystem.Clear('fnr_filter_cat')]"
				down = "[Not(GetVariableSystem.Exists('fnr_filter_cat'))]"
			}
			button_regular = {
				size = { 96 28 }
				raw_text = "Historical"
				onclick = "[GetVariableSystem.Set('fnr_filter_cat', 'historical')]"
				tooltip = "fnr_toggle_filter_cat_tt"
				down = "[GetVariableSystem.HasValue('fnr_filter_cat', 'historical')]"
			}
			button_regular = {
				size = { 118 28 }
				raw_text = "Non-Historical"
				onclick = "[GetVariableSystem.Set('fnr_filter_cat', 'nonhistorical')]"
				tooltip = "fnr_toggle_filter_cat_tt"
				down = "[GetVariableSystem.HasValue('fnr_filter_cat', 'nonhistorical')]"
			}
			button_regular = {
				size = { 98 28 }
				raw_text = "Alt-History"
				onclick = "[GetVariableSystem.Set('fnr_filter_cat', 'althistory')]"
				tooltip = "fnr_toggle_filter_cat_tt"
				down = "[GetVariableSystem.HasValue('fnr_filter_cat', 'althistory')]"
			}
			button_regular = {
				size = { 112 28 }
				raw_text = "Controversial"
				onclick = "[GetVariableSystem.Set('fnr_filter_cat', 'controversial')]"
				tooltip = "fnr_toggle_filter_cat_tt"
				down = "[GetVariableSystem.HasValue('fnr_filter_cat', 'controversial')]"
			}
			button_regular = {
				size = { 80 28 }
				raw_text = "Fantasy"
				onclick = "[GetVariableSystem.Set('fnr_filter_cat', 'fantasy')]"
				tooltip = "fnr_toggle_filter_cat_tt"
				down = "[GetVariableSystem.HasValue('fnr_filter_cat', 'fantasy')]"
			}
			button_regular = {
				size = { 70 28 }
				raw_text = "Meme"
				onclick = "[GetVariableSystem.Set('fnr_filter_cat', 'meme')]"
				tooltip = "fnr_toggle_filter_cat_tt"
				down = "[GetVariableSystem.HasValue('fnr_filter_cat', 'meme')]"
			}
			button_regular = {
				size = { 78 28 }
				raw_text = "Modern"
				onclick = "[GetVariableSystem.Set('fnr_filter_cat', 'modern')]"
				tooltip = "fnr_toggle_filter_cat_tt"
				down = "[GetVariableSystem.HasValue('fnr_filter_cat', 'modern')]"
			}
			button_regular = {
				size = { 124 28 }
				raw_text = "North American"
				onclick = "[GetVariableSystem.Set('fnr_filter_cat', 'us_states')]"
				tooltip = "fnr_toggle_filter_cat_tt"
				down = "[GetVariableSystem.HasValue('fnr_filter_cat', 'us_states')]"
			}
			button_regular = {
