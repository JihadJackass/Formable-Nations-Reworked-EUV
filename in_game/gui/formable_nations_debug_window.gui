# Formable Nations Settings GUI
#
# CLOSE LOGIC (updated for 1.4.6):
# - This window's visibility is bound to the 'formable_nations_debug_window_open'
#   variable, so the ONLY thing that can close it is clearing that variable.
# - 1.4.6 removed the vanilla blocks this file used to hook into
#   (button_close_alt -> "close_onclick", window_header_alt -> "button_close"),
#   and 'use_global_input_instance' is no longer a valid property.
# - The styled X now carries its own onclick, and the transparent overlay
#   button on top of it carries the 'close_window' shortcut (Esc). The overlay
#   uses no vanilla templates, so it keeps working if a patch changes them.

window = {
	name = "formable_nations_debug_window"
	layer = windows_layer
	parentanchor = hcenter|vcenter
	filter_mouse = all
	allow_outside = yes
	size = { 1000 430 }
	visible = "[GetVariableSystem.Exists('formable_nations_debug_window_open')]"
	using = bg_window_default_alt

	# Close button (top right of the window)
	widget = {
		parentanchor = top|right
		position = { -15 15 }
		size = { 40 40 }

		# Vanilla-styled X. If a patch renames its blocks again it falls back to
		# visuals only, and the overlay button below still does the work.
		button_close_alt = {
			# 1.4.6: vanilla closes this button through "close_on_action" (the old
			# "close_onclick" block is gone). Its own Esc binding is removed so only
			# the overlay button below owns Esc.
			blockoverride "close_on_action" { on_action = "[GetVariableSystem.Clear('formable_nations_debug_window_open')]" }
			blockoverride "close_inputaction" {}
		}

		# Patch-proof close: plain button, no vanilla templates involved.
		# Drawn after (on top of) the styled X, so it receives the click,
		# and it owns the Esc shortcut for this window.
		button = {
			size = { 40 40 }
			input_action = "close_window"
			tooltip = "fnr_settings_close_tooltip"   # or raw_text-style: tooltip = "Close (Esc)"
			onclick = "[GetVariableSystem.Clear('formable_nations_debug_window_open')]"
		}
	}
	vbox = {
		margin = { 30 10 }
		spacing = 6
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		window_header_alt = {
			blockoverride "header_text" {
				text = "fnr_settings_title"
			}
		}
		text_single = {
			text = "fnr_toggle_count"
		}

		# Tabs (GetVariableSystem 'fnr_settings_tab': none = Formables, 'custom', 'about'). The last tab used stays open.
		header_main_tabs = {
			blockoverride "content" {
				button_main_tab_alt = {
					using = layoutpolicy_expanding
					text = "fnr_settings_tab_formables"
					tooltip = "fnr_settings_tab_formables_tt"
					onclick = "[GetVariableSystem.Clear('fnr_settings_tab')]"
					down = "[Not(GetVariableSystem.Exists('fnr_settings_tab'))]"
				}
				button_main_tab_alt = {
					using = layoutpolicy_expanding
					text = "fnr_settings_tab_custom"
					tooltip = "fnr_settings_tab_custom_tt"
					onclick = "[GetVariableSystem.Set('fnr_settings_tab', 'custom')]"
					down = "[GetVariableSystem.HasValue('fnr_settings_tab', 'custom')]"
				}
				button_main_tab_alt = {
					using = layoutpolicy_expanding
					text = "fnr_settings_tab_about"
					tooltip = "fnr_settings_tab_about_tt"
					onclick = "[GetVariableSystem.Set('fnr_settings_tab', 'about')]"
					down = "[GetVariableSystem.HasValue('fnr_settings_tab', 'about')]"
				}
			}
		}

		# ===== Formables tab =====
		vbox = {
			layoutpolicy_horizontal = expanding
			visible = "[Not(GetVariableSystem.Exists('fnr_settings_tab'))]"
			spacing = 8
			margin_top = 6

			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							text_single = {
								size = { 100 32 }
								align = right|nobaseline
								text = "fnr_settings_row_timeline"
							}
							button_regular = { # Historical
								size = { 200 32 }
								text = "[SelectLocalization(GetPlayer.HasVariable('fnr_historical_enabled'), 'fnr_cat_historical_on', 'fnr_cat_historical_off')]"
								tooltip = "[SelectLocalization(GetPlayer.HasVariable('fnr_historical_enabled'), 'fnr_historical_tooltip_on', 'fnr_historical_tooltip_off')]"
								onclick = "[GetScriptedGui('FormableNationReworked_toggle_historical_formables').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_regular = { # Non-Historical
								size = { 200 32 }
								text = "[SelectLocalization(GetPlayer.HasVariable('fnr_nonhistorical_enabled'), 'fnr_cat_nonhistorical_on', 'fnr_cat_nonhistorical_off')]"
								tooltip = "[SelectLocalization(GetPlayer.HasVariable('fnr_nonhistorical_enabled'), 'fnr_nonhistorical_tooltip_on', 'fnr_nonhistorical_tooltip_off')]"
								onclick = "[GetScriptedGui('FormableNationReworked_toggle_nonhistorical_formables').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_regular = { # Alt-History
								size = { 200 32 }
								text = "[SelectLocalization(GetPlayer.HasVariable('fnr_althistory_enabled'), 'fnr_cat_althistory_on', 'fnr_cat_althistory_off')]"
								tooltip = "[SelectLocalization(GetPlayer.HasVariable('fnr_althistory_enabled'), 'fnr_althistorical_tooltip_on', 'fnr_althistorical_tooltip_off')]"
								onclick = "[GetScriptedGui('FormableNationReworked_toggle_althistory_formables').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_regular = { # Modern
								size = { 200 32 }
								text = "[SelectLocalization(GetPlayer.HasVariable('fnr_modern_enabled'), 'fnr_cat_modern_on', 'fnr_cat_modern_off')]"
								tooltip = "[SelectLocalization(GetPlayer.HasVariable('fnr_modern_enabled'), 'fnr_modern_tooltip_on', 'fnr_modern_tooltip_off')]"
								onclick = "[GetScriptedGui('FormableNationReworked_toggle_modern_formables').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							expand = {}
						}
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							text_single = {
								size = { 100 32 }
								align = right|nobaseline
								text = "fnr_settings_row_special"
							}
							button_regular = { # Controversial
								size = { 200 32 }
								text = "[SelectLocalization(GetPlayer.HasVariable('fnr_controversial_enabled'), 'fnr_cat_controversial_on', 'fnr_cat_controversial_off')]"
								tooltip = "[SelectLocalization(GetPlayer.HasVariable('fnr_controversial_enabled'), 'fnr_controversial_tooltip_on', 'fnr_controversial_tooltip_off')]"
								onclick = "[GetScriptedGui('FormableNationReworked_toggle_controversial_formables').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_regular = { # Fantasy
								size = { 200 32 }
								text = "[SelectLocalization(GetPlayer.HasVariable('fnr_fantasy_enabled'), 'fnr_cat_fantasy_on', 'fnr_cat_fantasy_off')]"
								tooltip = "[SelectLocalization(GetPlayer.HasVariable('fnr_fantasy_enabled'), 'fnr_fantasy_tooltip_on', 'fnr_fantasy_tooltip_off')]"
								onclick = "[GetScriptedGui('FormableNationReworked_toggle_fantasy_formables').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_regular = { # Meme
								size = { 200 32 }
								text = "[SelectLocalization(GetPlayer.HasVariable('fnr_meme_enabled'), 'fnr_cat_meme_on', 'fnr_cat_meme_off')]"
								tooltip = "[SelectLocalization(GetPlayer.HasVariable('fnr_meme_enabled'), 'fnr_meme_tooltip_on', 'fnr_meme_tooltip_off')]"
								onclick = "[GetScriptedGui('FormableNationReworked_toggle_meme_formables').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_regular = { # North American
								size = { 200 32 }
								text = "[SelectLocalization(GetPlayer.HasVariable('fnr_us_states_enabled'), 'fnr_cat_us_states_on', 'fnr_cat_us_states_off')]"
								tooltip = "[SelectLocalization(GetPlayer.HasVariable('fnr_us_states_enabled'), 'fnr_north_american_tooltip_on', 'fnr_north_american_tooltip_off')]"
								onclick = "[GetScriptedGui('FormableNationReworked_toggle_us_states_formables').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							expand = {}
						}
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							text_single = {
								size = { 100 32 }
								align = right|nobaseline
								text = "fnr_settings_row_base"
							}
							button_regular = { # Vanilla (inverted variable: set means OFF)
								size = { 200 32 }
								text = "[SelectLocalization(GetPlayer.HasVariable('fnr_vanilla_formables_disabled'), 'fnr_cat_vanilla_off', 'fnr_cat_vanilla_on')]"
								tooltip = "[SelectLocalization(GetPlayer.HasVariable('fnr_vanilla_formables_disabled'), 'fnr_vanilla_tooltip_off', 'fnr_vanilla_tooltip_on')]"
								onclick = "[GetScriptedGui('FormableNationReworked_toggle_vanilla_formables').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_regular = { # Papal States (only the Papacy can use it)
								size = { 200 32 }
								text = "[SelectLocalization(GetPlayer.HasVariable('fnr_is_papacy'), 'fnr_cat_papal_on', 'fnr_cat_papal_off')]"
								tooltip = "[SelectLocalization(GetPlayer.HasVariable('fnr_is_papacy'), 'fnr_papal_states_tooltip_on', 'fnr_papal_states_tooltip_off')]"
								onclick = "[GetScriptedGui('FormableNationReworked_toggle_papal_formables').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							expand = {}
						}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin_top = 6
				widget = { size = { 106 20 } }
				text_single = {
					text = "fnr_settings_presets_header"
				}
				expand = {}
			}
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6
				widget = { size = { 100 32 } }
							button_regular = {
								size = { 200 32 }
								text = "fnr_preset_default"
								tooltip = "fnr_preset_default_tt"
								onclick = "[GetScriptedGui('FormableNationReworked_preset_default').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_regular = {
								size = { 200 32 }
								text = "fnr_preset_plausible"
								tooltip = "fnr_preset_plausible_tt"
								onclick = "[GetScriptedGui('FormableNationReworked_preset_plausible').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_regular = {
								size = { 200 32 }
								text = "fnr_preset_everything"
								tooltip = "fnr_preset_everything_tt"
								onclick = "[GetScriptedGui('FormableNationReworked_preset_everything').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
							button_regular = {
								size = { 200 32 }
								text = "fnr_preset_vanilla_only"
								tooltip = "fnr_preset_vanilla_only_tt"
								onclick = "[GetScriptedGui('FormableNationReworked_preset_vanilla_only').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							}
				expand = {}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin_top = 8
				spacing = 6
				widget = { size = { 100 34 } }
				button_regular = {
					size = { 300 34 }
					text = "fnr_settings_open_list"
					tooltip = "fnr_debug_window_formable_list_loc"
					onclick = "[GetVariableSystem.Set('formable_list_window_open', 'yes')]"
					onclick = "[GetScriptedGui('FormableNationReworked_count_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				expand = {}
			}
		}

		# ===== Customization tab =====
		vbox = {
			layoutpolicy_horizontal = expanding
			visible = "[GetVariableSystem.HasValue('fnr_settings_tab', 'custom')]"
			spacing = 10
			margin_top = 10

			text_multi = {
				autoresize = yes
				max_width = 900
				text = "fnr_settings_custom_text"
			}
			hbox = {
				spacing = 6
				button_regular = {
					size = { 260 32 }
					enabled = no # the window does not exist yet
					text = "fnr_settings_flag_selection"
					tooltip = "fnr_debug_window_formable_list_loc_flag_selection"
					onclick = "[GetVariableSystem.Set('flag_selection_window_open', 'yes')]"
				}
				button_regular = {
					size = { 260 32 }
					enabled = no # the window does not exist yet
					text = "fnr_settings_color_selection"
					tooltip = "fnr_debug_window_formable_list_loc_color_selection"
					onclick = "[GetVariableSystem.Set('color_selection_window_open', 'yes')]"
				}
				expand = {}
			}
		}

		# ===== About tab =====
		vbox = {
			layoutpolicy_horizontal = expanding
			visible = "[GetVariableSystem.HasValue('fnr_settings_tab', 'about')]"
			margin_top = 10

			text_multi = {
				autoresize = yes
				max_width = 900
				text = "fnr_settings_about_text"
			}
		}

		expand = {}
	}
}
